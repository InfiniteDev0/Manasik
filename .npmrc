# Hoist nothing by default — keeps dependency boundaries honest across workspaces.
# Next.js and its plugin ecosystem need these public-hoisted to resolve correctly.
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
public-hoist-pattern[]=@types/*

# Workspace packages resolve to the local source, never the registry.
link-workspace-packages=true
prefer-workspace-packages=true

# Fail fast in CI instead of silently resolving a different tree.
strict-peer-dependencies=false
auto-install-peers=true
