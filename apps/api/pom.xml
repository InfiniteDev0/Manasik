<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<!-- Plain `4.1.0`. Spring Initializr writes `4.1.0.RELEASE` into generated
		     poms, but that is its internal version id — the artifact published to
		     Maven Central is `4.1.0` and `.RELEASE` fails to resolve. -->
		<version>4.1.0</version>
		<relativePath/>
	</parent>

	<groupId>com.manasik</groupId>
	<artifactId>api</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>api</name>
	<description>Manasik API - the operating system for Hajj and Umrah agencies</description>

	<properties>
		<!--
			Java 17 is the installed JDK and is Spring Boot 4's baseline. Spring
			recommends 21+ for virtual threads; that's an upgrade we can take
			later without code changes.
		-->
		<java.version>17</java.version>

		<!-- springdoc 3.x is the line that supports Boot 4. 2.x is Boot 3 only. -->
		<springdoc.version>3.1.0</springdoc.version>
		<mapstruct.version>1.6.3</mapstruct.version>
		<lombok-mapstruct-binding.version>0.2.0</lombok-mapstruct-binding.version>
		<testcontainers.version>1.21.4</testcontainers.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<!--
				Boot 4's BOM does not manage Testcontainers versions, so the
				modules must be aligned here. Mixing versions across
				testcontainers artifacts produces confusing NoSuchMethodErrors
				at container startup rather than a clean resolution failure.
			-->
			<dependency>
				<groupId>org.testcontainers</groupId>
				<artifactId>testcontainers-bom</artifactId>
				<version>${testcontainers.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>
		<!-- NOTE: Boot 4 renamed this from `spring-boot-starter-web`. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>

		<!--
			PHASE 3 — persistence.

			Redis is deliberately absent. Refresh-token JTIs live in the
			`refresh_sessions` table instead: same rotation and reuse-detection
			semantics, one less service to host. Revisit when traffic justifies it.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-core</artifactId>
		</dependency>
		<!-- Flyway split PostgreSQL support into its own module; without this
		     it fails at startup with "Unsupported Database: PostgreSQL". -->
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>
		<!--
			REQUIRED, and easy to miss. Boot 4 moved FlywayAutoConfiguration into
			its own `spring-boot-flyway` module. With only flyway-core on the
			classpath, Boot 4 does NOT run migrations — and it fails SILENTLY:
			no warning, no error, the app just starts against an unmigrated
			database. Boot 3 wired this up from spring-boot-autoconfigure.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-flyway</artifactId>
		</dependency>

		<!-- OpenAPI / Swagger UI -->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>${springdoc.version}</version>
		</dependency>

		<!-- Entity <-> DTO mapping -->
		<dependency>
			<groupId>org.mapstruct</groupId>
			<artifactId>mapstruct</artifactId>
			<version>${mapstruct.version}</version>
		</dependency>

		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>

		<!--
			Testcontainers — a real PostgreSQL for the tenant-isolation tests.

			H2 or an in-memory database would be useless here: neither implements
			row-level security, so the very thing under test would silently not
			exist and every assertion would pass for the wrong reason.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>postgresql</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- Boot 4 splits testing into per-starter test artifacts. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>

			<!--
				Runs *IT classes during `verify`.

				Surefire (`mvn test`) only picks up *Test / Test* / *Tests, so
				without this the integration tests are silently skipped — the
				build stays green while nothing is actually verified. Failsafe
				also runs post-integration-test cleanup even when tests fail,
				which Surefire does not.
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-failsafe-plugin</artifactId>
				<executions>
					<execution>
						<goals>
							<goal>integration-test</goal>
							<goal>verify</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<!--
						Order matters. Lombok must run before MapStruct, otherwise
						MapStruct generates mappers against the pre-Lombok class and
						can't see the generated getters/setters. lombok-mapstruct-binding
						is what makes the two cooperate.
					-->
					<annotationProcessorPaths>
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</path>
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok-mapstruct-binding</artifactId>
							<version>${lombok-mapstruct-binding.version}</version>
						</path>
						<path>
							<groupId>org.mapstruct</groupId>
							<artifactId>mapstruct-processor</artifactId>
							<version>${mapstruct.version}</version>
						</path>
					</annotationProcessorPaths>
					<compilerArgs>
						<!-- Fail the build on an unmapped target property rather than
						     silently producing a DTO with null fields. -->
						<compilerArg>-Amapstruct.unmappedTargetPolicy=ERROR</compilerArg>
						<compilerArg>-Amapstruct.defaultComponentModel=spring</compilerArg>
					</compilerArgs>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
