{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2020",
    // DOM is included because these packages are consumed by the Next.js app
    // and run in the browser. Without it, globals like `URL` (used in
    // @manasik/utils) resolve to nothing.
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "CommonJS",
    "moduleResolution": "node",
    "ignoreDeprecations": "5.0",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    // Deliberately NOT `["node"]`. Only packages that actually touch Node
    // globals should pull in @types/node, and they must declare it as their
    // own devDependency — pnpm won't hoist it for them.
    "types": []
  },
  "exclude": ["node_modules"]
}
