# ─────────────────────────────────────────────────────────────────────────────
# Manasik — environment reference
# ─────────────────────────────────────────────────────────────────────────────
#
# This file is COMMITTED and must never contain a real secret.
#
# There are two separate environments; they do not share a file:
#
#   apps/api/.env         → Spring Boot. Server-side secrets live here.
#   apps/web/.env.local   → Next.js. NEXT_PUBLIC_* only, shipped to the browser.
#
# Copy the relevant block into the right file and fill it in.


# ═════════════════════════════════════════════════════════════════════════════
# apps/api/.env  —  Spring Boot (gitignored)
# ═════════════════════════════════════════════════════════════════════════════

SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=4000

# ── Database ─────────────────────────────────────────────────────────────────
# Local Postgres from docker-compose.yml at the repo root.
# Flyway owns this schema (ROADMAP D1) — never hand-edit tables.
DB_URL=jdbc:postgresql://localhost:5432/manasik
DB_USERNAME=manasik
DB_PASSWORD=change_me

# The application connects as a NON-OWNER role so Postgres Row-Level Security
# actually applies to it (table owners bypass RLS unless FORCE is set).
# See ROADMAP D2 / Phase 3.
DB_APP_USERNAME=manasik_app
DB_APP_PASSWORD=change_me

# ── Redis ────────────────────────────────────────────────────────────────────
# Stores refresh-token JTIs and rate-limit counters.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── JWT ──────────────────────────────────────────────────────────────────────
# Two INDEPENDENT secrets — never reuse one for both. Generate each with:
#   [Convert]::ToBase64String((1..64 | % { Get-Random -Max 256 }))
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="Manasik <noreply@yourdomain.com>"
# Dev safety net: when set, ALL outgoing mail is redirected here so a test
# registration can never reach a real person. Leave EMPTY in production.
EMAIL_DEV_OVERRIDE=

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000


# ═════════════════════════════════════════════════════════════════════════════
# apps/web/.env.local  —  Next.js (gitignored)
# ═════════════════════════════════════════════════════════════════════════════
#
# ⚠️ Everything below is inlined into the JS bundle and visible to anyone who
# opens devtools. A secret placed here is a published secret.

NEXT_PUBLIC_API_URL=http://localhost:4000/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
