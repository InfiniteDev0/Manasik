# ─────────────────────────────────────────────────────────────────────────────
# Manasik — environment reference
# ─────────────────────────────────────────────────────────────────────────────
#
# This file is COMMITTED and must never contain a real secret.
#
# Copy the block below into apps/web/.env.local (gitignored) and fill it in.


# ═════════════════════════════════════════════════════════════════════════════
# apps/web/.env.local  —  Next.js
# ═════════════════════════════════════════════════════════════════════════════

# Supabase → Project Settings → API Keys.
# Use the PUBLISHABLE key (sb_publishable_…), never the secret key. It only
# identifies the project; Row Level Security is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Not needed yet. When something must bypass RLS on the server (a cron job, a
# webhook), it goes here WITHOUT the NEXT_PUBLIC_ prefix so it never reaches
# the browser:
# SUPABASE_SECRET_KEY=
